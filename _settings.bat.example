@echo off
REM ============================================================
REM  SHARED CONNECTION SETTINGS  (template, HANA edition)
REM ------------------------------------------------------------
REM  Copy this file to _settings.bat (without .example) and edit
REM  the values for your environment. _settings.bat is gitignored.
REM ============================================================

REM SERVER format = host:port  (HANA SQL port, default 30015 for SYSTEMDB,
REM 3<NN>15 for tenant DB instance NN)
set SERVER=10.10.10.109:30015

REM COMPANYDB on HANA = the company's SCHEMA name (e.g. SBO_ENCONFUND_TRAINING).
REM Find it with:  SELECT SCHEMA_NAME FROM SYS.SCHEMAS WHERE SCHEMA_NAME LIKE 'SBO%'
set COMPANYDB=SBO_ENCONFUND_TRAINING

set DBUSER=SYSTEM
set DBPASSWORD=YourPasswordHere

REM Root folder containing .rpt files. The RPT_Folder column in
REM RPT_Import_Map.xlsx is resolved relative to this path.
set RPTROOT=C:\GitHub\Enconfund\FORM
